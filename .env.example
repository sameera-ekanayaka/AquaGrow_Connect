# Supabase Cloud Configuration
# Replace these values with your actual project credentials from the Supabase dashboard.
# If left empty, the application automatically runs in mock fallback mode.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional MQTT Broker Settings for Member 1 Telemetry Streaming
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=aquagrow_mobile_client

# OpenWeatherMap API Key for Member 3 Microclimate Services
OPENWEATHERMAP_API_KEY=your-openweather-api-key
